    {
      "cell_type": "code",
      "source": [
        "%%writefile server_stage1_audio.py\n",
        "import os\n",
        "import shutil\n",
        "import subprocess\n",
        "import uvicorn\n",
        "import librosa\n",
        "import noisereduce as nr\n",
        "import soundfile as sf\n",
        "from fastapi import FastAPI, UploadFile, File\n",
        "from fastapi.responses import FileResponse\n",
        "from fastapi.middleware.cors import CORSMiddleware\n",
        "from pyngrok import ngrok\n",
        "\n",
        "# Initialize project directory\n",
        "PROJECT_DIR = '/content/drive/MyDrive/Video_Translation_Project/Stage_1'\n",
        "if os.path.exists('/content/drive/MyDrive'):\n",
        "    os.makedirs(PROJECT_DIR, exist_ok=True)\n",
        "\n",
        "app = FastAPI(title=\"Stage 1: Audio Processing API\")\n",
        "\n",
        "# Enable CORS so the HTML UI can communicate with this API\n",
        "app.add_middleware(\n",
        "    CORSMiddleware,\n",
        "    allow_origins=[\"*\"],\n",
        "    allow_credentials=True,\n",
        "    allow_methods=[\"*\"],\n",
        "    allow_headers=[\"*\"],\n",
        ")\n",
        "\n",
        "@app.post(\"/process_stage1\")\n",
        "async def process_stage1(video: UploadFile = File(...)):\n",
        "    input_video = \"/content/input_video.mp4\"\n",
        "    raw_audio = \"/content/raw_audio.wav\"\n",
        "    silent_video = \"/content/silent_video.mp4\"\n",
        "    demucs_out_dir = \"/content/separated\"\n",
        "    demucs_vocals = f\"{demucs_out_dir}/htdemucs/raw_audio/vocals.wav\"\n",
        "\n",
        "    print(\"[INFO] Receiving video file from UI...\")\n",
        "    with open(input_video, \"wb\") as buffer:\n",
        "        shutil.copyfileobj(video.file, buffer)\n",
        "\n",
        "    print(\"[INFO] Extracting silent video...\")\n",
        "    subprocess.run(['ffmpeg', '-y', '-i', input_video, '-c:v', 'copy', '-an', silent_video], check=True)\n",
        "\n",
        "    print(\"[INFO] Extracting raw audio...\")\n",
        "    subprocess.run(['ffmpeg', '-y', '-i', input_video, '-vn', '-acodec', 'pcm_s16le', '-ac', '1', '-ar', '16000', raw_audio], check=True)\n",
        "\n",
        "    print(\"[INFO] Separating vocals using Demucs (This may take a moment)...\")\n",
        "    subprocess.run(['python3', '-m', 'demucs.separate', '-n', 'htdemucs', '--two-stems', 'vocals', '-o', demucs_out_dir, raw_audio], check=True)\n",
        "\n",
        "    if not os.path.exists(demucs_vocals):\n",
        "        return {\"error\": \"Demucs failed to create vocals.wav. Please check the Colab output logs for the exact error.\"}\n",
        "\n",
        "    print(\"[INFO] Reducing background noise adaptively...\")\n",
        "    audio_data, sr = librosa.load(demucs_vocals, sr=None)\n",
        "\n",
        "    # Adaptive processing to preserve original audio quality\n",
        "    clean_audio_data = nr.reduce_noise(\n",
        "        y=audio_data,\n",
        "        sr=sr,\n",
        "        stationary=False,         # Adaptive processing for variable noise\n",
        "        prop_decrease=0.4,        # Reduce noise by 40% instead of 100% to avoid robotic sound\n",
        "        time_mask_smooth_ms=64    # Smooth time masking to prevent voice stuttering\n",
        "    )\n",
        "\n",
        "    sf.write(\"/content/clean_vocals.wav\", clean_audio_data, sr)\n",
        "\n",
        "    print(\"[INFO] Stage 1 Processing Complete!\")\n",
        "    return {\"message\": \"Success\"}\n",
        "\n",
        "@app.get(\"/get_silent_video\")\n",
        "def get_silent_video():\n",
        "    return FileResponse(\"/content/silent_video.mp4\", media_type=\"video/mp4\")\n",
        "\n",
        "@app.get(\"/get_clean_vocals\")\n",
        "def get_clean_vocals():\n",
        "    return FileResponse(\"/content/clean_vocals.wav\", media_type=\"audio/wav\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    # Forcefully kill any running ngrok processes at the OS level to prevent ERR_NGROK_334\n",
        "    os.system(\"pkill -f ngrok\")\n",
        "\n",
        "    ngrok.set_auth_token(\"")\n",
        "\n",
        "    public_url = ngrok.connect(8000).public_url\n",
        "    print(\"Stage 1 API:\", public_url)\n",
        "\n",
        "    uvicorn.run(app, host=\"0.0.0.0\", port=8000)"
      ],
      "metadata": {
